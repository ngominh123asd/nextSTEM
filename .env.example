# ── Frontend Environment Variables ──────────────────────────
# Vite only exposes variables prefixed with VITE_

# Backend API URL (no trailing slash)
# Local development:
VITE_API_URL=http://localhost:8000
# Production — set this in Vercel Dashboard → Settings → Environment Variables:
# VITE_API_URL=https://your-backend.up.railway.app

# Google OAuth Client ID
# Required for Google Login to work.
VITE_GOOGLE_CLIENT_ID=

# Facebook App ID
# Required for Facebook Login to work.
VITE_FACEBOOK_APP_ID=

# Gemini AI key (optional, for AI features)
# Set in Vercel Dashboard for production
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────
# VERCEL DASHBOARD — Environment Variables to set:
#   VITE_API_URL  = https://<your-railway-app>.up.railway.app
#   VITE_GOOGLE_CLIENT_ID = <your-google-client-id>
#   VITE_FACEBOOK_APP_ID = <your-facebook-app-id>
#   GEMINI_API_KEY = <your-gemini-api-key>
# ─────────────────────────────────────────────────────────────
